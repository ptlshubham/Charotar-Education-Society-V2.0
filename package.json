{
  "name": "zarklyx-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "start:local": "ng serve --configuration=local",
    "dev": "ng serve --configuration=development",
    "dev:local": "ng serve --configuration=local",
    "serve:staging": "ng serve --configuration=staging",
    "serve:testing": "ng serve --configuration=testing",
    "serve:prod": "ng serve --configuration=production",
    "build": "npm run site:files && ng build --configuration=production",
    "build:staging": "npm run site:files && ng build --configuration=staging",
    "build:testing": "npm run site:files && ng build --configuration=testing",
    "build:prod": "npm run site:files && ng build --configuration=production",
    "watch": "ng build --watch --configuration=staging",
    "test": "ng test",
    "site:files": "node scripts/generate-site-files.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "serve:ssr:zarklyx-website": "node dist/zarklyx-website/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/ssr": "^21.2.18",
    "@tailwindcss/vite": "^4.3.1",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "swiper": "^14.0.2",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
