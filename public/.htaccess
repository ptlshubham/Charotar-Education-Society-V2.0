# ---------------------------------------------------------------------------
# ZarklyX Website — prerendered Angular deployed as static files (Hostinger)
# Deployed to apex + dev/test/stage/app subdomains, so no host is hardcoded.
# ---------------------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# 1. Redirects — force HTTPS and canonicalize the host (strip leading www.)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Force HTTPS, preserving whatever host was requested (works on every subdomain).
	RewriteCond %{HTTPS} !=on
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Canonicalize: www.<anything>  ->  <anything>  (leaves dev/test/stage/app as-is).
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

	# Keep real files/directories untouched (prerendered /route/index.html included).
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Serve a prerendered per-route HTML file when one exists (SEO), skipping /api.
	RewriteCond %{REQUEST_URI} !^/api
	RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
	RewriteRule ^(.+?)/?$ /$1/index.html [L]

	# Angular SPA fallback for deep links like /auth/login (never for API calls).
	RewriteCond %{REQUEST_URI} !^/api
	RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 1b. MIME types — guarantee modern image formats are served with the correct
# Content-Type. Some shared hosts don't know webp/avif and fall back to
# application/octet-stream, which together with the nosniff header below stops
# the browser rendering the image (photos appear broken in production only).
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
	AddType image/webp                       .webp
	AddType image/avif                       .avif
	AddType image/svg+xml                     .svg .svgz
	AddType image/x-icon                      .ico
</IfModule>

# ---------------------------------------------------------------------------
# 2. Compression — Brotli when available, gzip/deflate as fallback
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
		text/javascript application/javascript application/json application/xml \
		application/rss+xml image/svg+xml application/wasm font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
		text/javascript application/javascript application/json application/xml \
		application/rss+xml image/svg+xml application/wasm font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching — hashed build assets are immutable; HTML must always revalidate
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css                  "access plus 1 year"
	ExpiresByType application/javascript     "access plus 1 year"
	ExpiresByType text/javascript            "access plus 1 year"
	ExpiresByType application/wasm           "access plus 1 year"
	ExpiresByType image/png                  "access plus 1 year"
	ExpiresByType image/jpeg                 "access plus 1 year"
	ExpiresByType image/gif                  "access plus 1 year"
	ExpiresByType image/webp                 "access plus 1 year"
	ExpiresByType image/avif                 "access plus 1 year"
	ExpiresByType image/svg+xml              "access plus 1 year"
	ExpiresByType image/x-icon               "access plus 1 year"
	ExpiresByType font/woff2                 "access plus 1 year"
	ExpiresByType font/woff                  "access plus 1 year"
	ExpiresByType font/ttf                   "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
	ExpiresByType text/html                  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
	# Fingerprinted static assets never change under the same URL.
	<FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico|wasm)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# HTML (index.html and prerendered routes) must revalidate so deploys go live.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"
	# HSTS only over HTTPS; no includeSubDomains so a lagging subdomain cert can't be bricked.
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
	Header always unset X-Powered-By
	Header unset X-Powered-By
</IfModule>
