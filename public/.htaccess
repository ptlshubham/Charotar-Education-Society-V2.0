# ---------------------------------------------------------------------------
# Charotar Education Society - prerendered Angular deployed as static files
# Deployed to apex + any dev/test/stage subdomain, so no host is hardcoded.
#
# NOTE: the previous site used hash routing (https://cesociety.in/#/about).
# Those URLs are NOT redirected here and cannot be: a browser never sends the
# "#..." fragment to the server, so mod_rewrite only ever sees "/". That
# redirect lives in src/index.html and runs before the app boots.
# ---------------------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# 1. Redirects - force HTTPS and canonicalize the host (strip leading www.)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Hostinger keeps each subdomain's files in a folder in here (public_html/chatkaro is
	# chatkaro.cesociety.in, likewise mba and dashboard), and these rules would reach those sites
	# too - a missing page on one would loop to this app's shell and fail with a 500. A request
	# whose path doesn't match the URL came in through such a subdomain: leave it to that site.
	RewriteCond %{REQUEST_URI}::$0 !^/(.*)::\1$
	RewriteRule .* - [L]

	# Force HTTPS, preserving whatever host was requested (works on every subdomain).
	RewriteCond %{HTTPS} !=on
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Canonicalize: www.<anything>  ->  <anything>  (leaves dev/test/stage/app as-is).
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

	# Live from the CES API through site-live.php, so a blog post published in the dashboard is in
	# the sitemap and llms.txt, and readable by crawlers, at once - no rebuild. Ahead of the
	# real-file rules on purpose: sitemap.xml and llms.txt are only the build's fallback copies.
	RewriteRule ^sitemap\.xml$ site-live.php?f=sitemap [L]
	RewriteRule ^llms\.txt$ site-live.php?f=llms [L]
	RewriteRule ^blog/[^/]+/?$ site-live.php?f=post [L]

	# public_html/chatkaro is the chatkaro.cesociety.in subdomain's folder, so the build ships this
	# site's /chatkaro page as chatkaro.html (scripts/after-build.mjs). Ahead of the real-directory
	# rule, which would otherwise show the subdomain's files here.
	RewriteRule ^chatkaro/?$ chatkaro.html [L]

	# Site photos are WebP now; old .jpg/.png addresses (links shared before the switch, Google
	# Images, SEO Management rows) keep working. A page banner was also its share image, so it
	# goes to its 1200x630 JPG card in og-image/; any other photo to its .webp.
	RewriteCond %{DOCUMENT_ROOT}/assets/images/og-image/$1.jpg -f
	RewriteRule ^assets/images/hero/([a-z0-9-]+)\.(?:jpe?g|png)$ /assets/images/og-image/$1.jpg [R=301,L]
	RewriteCond %{DOCUMENT_ROOT}/assets/images/$1.webp -f
	RewriteRule ^assets/images/(.+)\.(?:jpe?g|png)$ /assets/images/$1.webp [R=301,L]
	# A share card that hasn't been made yet (SeoService asks for og-image/<name>.jpg for a page
	# banner, og-image/<folder>/<name>.jpg for any other photo) falls back to the photo itself.
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{DOCUMENT_ROOT}/assets/images/hero/$1.webp -f
	RewriteRule ^assets/images/og-image/([^/]+)\.jpg$ /assets/images/hero/$1.webp [R=302,L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{DOCUMENT_ROOT}/assets/images/$1.webp -f
	RewriteRule ^assets/images/og-image/(.+/.+)\.jpg$ /assets/images/$1.webp [R=302,L]

	# Keep real files/directories untouched (prerendered /route/index.html included).
	# NOTE: for a prerendered page the server answers /about with a 301 to /about/ (the folder's
	# trailing slash, added by the server itself before any rule here can serve the file). Dropping
	# that needs "DirectorySlash Off" plus a /about/ -> /about rule - tested on Apache 2026-10-28,
	# but NOT yet on Hostinger's LiteSpeed, where getting it wrong loops every page. Until then
	# index.html's first script drops the slash in the browser, before Google Analytics reads the
	# address (otherwise the app's own fix-up counted every visit twice).
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# A missing image is a 404, not the app shell (which would answer an <img> with HTML).
	RewriteRule \.(?:jpe?g|png|gif|webp|avif|svg|ico)$ - [R=404,L]

	# Serve a prerendered per-route HTML file when one exists (SEO), skipping /api.
	RewriteCond %{REQUEST_URI} !^/api
	RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
	RewriteRule ^(.+?)/?$ /$1/index.html [L]

	# Angular SPA fallback for routes with no prerendered file (e.g. /navratri/2026). index.csr.html
	# is the empty app shell; index.html is the prerendered home page, which the app would try to
	# hydrate as the wrong page. Never for API calls.
	RewriteCond %{REQUEST_URI} !^/api
	RewriteRule . /index.csr.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# 1b. MIME types - guarantee modern image formats are served with the correct
# Content-Type. Some shared hosts don't know webp/avif and fall back to
# application/octet-stream, which together with the nosniff header below stops
# the browser rendering the image (photos appear broken in production only).
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
	AddType image/webp                       .webp
	AddType image/avif                       .avif
	AddType image/svg+xml                     .svg .svgz
	AddType image/x-icon                      .ico
</IfModule>

# ---------------------------------------------------------------------------
# 2. Compression - Brotli when available, gzip/deflate as fallback
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
		text/javascript application/javascript application/json application/xml \
		application/rss+xml image/svg+xml application/wasm font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
		text/javascript application/javascript application/json application/xml \
		application/rss+xml image/svg+xml application/wasm font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching - hashed build assets are immutable; HTML must always revalidate
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css                  "access plus 1 year"
	ExpiresByType application/javascript     "access plus 1 year"
	ExpiresByType text/javascript            "access plus 1 year"
	ExpiresByType application/wasm           "access plus 1 year"
	ExpiresByType image/png                  "access plus 1 year"
	ExpiresByType image/jpeg                 "access plus 1 year"
	ExpiresByType image/gif                  "access plus 1 year"
	ExpiresByType image/webp                 "access plus 1 year"
	ExpiresByType image/avif                 "access plus 1 year"
	ExpiresByType image/svg+xml              "access plus 1 year"
	ExpiresByType image/x-icon               "access plus 1 year"
	ExpiresByType font/woff2                 "access plus 1 year"
	ExpiresByType font/woff                  "access plus 1 year"
	ExpiresByType font/ttf                   "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
	ExpiresByType text/html                  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
	# Fingerprinted static assets never change under the same URL.
	<FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico|wasm)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# HTML (index.html and prerendered routes) must revalidate so deploys go live.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"
	# HSTS only over HTTPS; no includeSubDomains so a lagging subdomain cert can't be bricked.
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
	Header always unset X-Powered-By
	Header unset X-Powered-By
</IfModule>
